{
  "name": "mealmcp",
  "private": true,
  "version": "0.5.2",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:generate": "npm run db:generate -w server",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=24"
  }
}
