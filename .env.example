# Public address of the app as seen by your browsers and MCP clients (no path).
# Used for the MCP OAuth endpoints and to secure cookies.
# Remote MCP clients (Claude, etc.) require HTTPS: put the app behind an HTTPS
# reverse proxy and set its address here, e.g. https://meals.example.com
PUBLIC_URL=http://localhost:3000

# The first account created becomes the owner of a household. After that, only
# invited people (invite code) can sign up. Set to true to open sign-ups to anyone.
ALLOW_REGISTRATION=false

# Number of reverse proxies in front of the app (1 behind Caddy/Nginx/Traefik, 0 otherwise).
# Needed so that login rate limiting sees the real client IP.
TRUST_PROXY=0

# Port published on the host by docker compose (inside the container the app always
# listens on 3000). If you change it, update PUBLIC_URL too, unless you use a reverse proxy.
# Outside Docker, this is the port the app listens on.
PORT=3000

# Time zone used for "today" in the meal plan and expiry dates (docker compose).
# Defaults to UTC; set yours, e.g. Europe/Paris or America/New_York.
TZ=UTC

# Outside Docker only: with docker compose the database lives in the mealmcp-data volume.
DATABASE_PATH=./data/mealmcp.db
