# Adresse publique de l'application, telle que vue par vos navigateurs et clients MCP
# (sans chemin). Utilisée pour l'OAuth du MCP et pour sécuriser les cookies.
# Les clients MCP distants (Claude, etc.) exigent HTTPS : placez l'app derrière un
# reverse proxy HTTPS et indiquez ici son adresse, par ex. https://repas.example.com
PUBLIC_URL=http://localhost:3000

# Le premier compte créé devient propriétaire d'un foyer. Ensuite, seules les personnes
# invitées (code d'invitation) peuvent s'inscrire. Mettez true pour ouvrir les inscriptions.
ALLOW_REGISTRATION=false

# Nombre de reverse proxies devant l'app (1 derrière Caddy/Nginx/Traefik, 0 sinon).
# Nécessaire pour que la limitation des tentatives de connexion voie la vraie IP.
TRUST_PROXY=0

# Port exposé sur la machine par docker compose (l'app écoute toujours sur 3000 dans le
# conteneur). Si vous le changez, mettez aussi à jour PUBLIC_URL, sauf derrière un reverse proxy.
# Hors Docker, c'est le port d'écoute de l'app.
PORT=3000

# Hors Docker uniquement : avec docker compose, la base est dans le volume mealmcp-data.
DATABASE_PATH=./data/mealmcp.db
